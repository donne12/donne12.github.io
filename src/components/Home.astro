---
import Base from "../layouts/Base.astro";
import Nav from "./Nav.astro";
import Splash from "./Splash.astro";
import Cursor from "./Cursor.astro";
import Marquee from "./Marquee.astro";
import DocViewer from "./DocViewer.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import Skills from "./Skills.astro";
import Portfolio from "./Portfolio.astro";
import Experience from "./Experience.astro";
import Education from "./Education.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Base lang={lang}>
  <Splash />
  <Cursor />
  <div id="scroll-progress" class="fixed inset-x-0 top-0 z-[60] h-[2px] origin-left scale-x-0 bg-gradient-to-r from-accent to-accent-2"></div>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <Marquee />
    <About lang={lang} />
    <Skills lang={lang} />
    <Portfolio lang={lang} />
    <Experience lang={lang} />
    <Education lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <DocViewer lang={lang} />
</Base>

<script>
  import "../scripts/ui";
  import "../scripts/motion";
  import "../scripts/doc-viewer";
</script>
