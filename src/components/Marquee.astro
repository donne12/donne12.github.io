---
// Two counter-scrolling bands of the stack between the hero and the content.
import TechIcon from "./TechIcon.astro";
import { tech } from "../data/tech";

const rows = [
  ["dotnet", "angular", "csharp", "claudecode", "flutter", "react", "codex", "nextjs", "nodejs", "copilot", "spring", "php"],
  ["aspnet", "typescript", "rxjs", "python", "java", "kotlin", "sqlserver", "postgresql", "docker", "uipath"],
];
---

<section class="relative overflow-hidden py-4 select-none" aria-hidden="true">
  {
    rows.map((items, i) => (
      <div
        class:list={[
          "relative -mx-[5%] w-[110%] overflow-hidden border-y border-line",
          i ? "-mt-px -rotate-1 bg-bg" : "rotate-1 bg-accent text-white",
        ]}
      >
      <div data-marquee={i % 2 ? "-1" : "1"} class="flex w-max py-4">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {items.map((slug) => (
              <span class="flex items-center gap-8 pr-8 font-display text-2xl font-semibold tracking-tight whitespace-nowrap sm:text-4xl">
                <span class="flex items-center gap-3 sm:gap-4">
                  <span class:list={["grid shrink-0 place-items-center rounded-xl p-1.5 sm:p-2", i ? "border border-line bg-bg-soft" : "bg-white"]}>
                    <TechIcon slug={slug} size={28} class:list={[!i && "!filter-none"]} />
                  </span>
                  {tech[slug].name}
                </span>
                <span class:list={["text-base", i ? "text-accent-2" : "text-white/60"]}>✦</span>
              </span>
            ))}
          </div>
        ))}
      </div>
      </div>
    ))
  }
</section>
