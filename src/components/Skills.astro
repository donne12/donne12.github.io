---
import SectionHeading from "./SectionHeading.astro";
import TechIcon from "./TechIcon.astro";
import { aiAgents, skills } from "../data/content";
import { tech } from "../data/tech";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<section id="skill" class="relative py-12 sm:py-16">
  <div class="container-x">
    <SectionHeading index="02" label={t("nav.skills")} title={t("skills.title")} />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((group) => (
          <article data-reveal class="glass group rounded-3xl p-6 transition-colors hover:bg-card-hover">
            <h3 class="mb-6 font-display text-lg font-semibold">{t(group.key)}</h3>
            <ul class="space-y-3.5">
              {group.items.map(([name, pct, logos]) => (
                <li>
                  <div class="mb-2 flex items-center justify-between gap-3 font-mono text-xs">
                    <span class="flex min-w-0 items-center gap-2.5">
                      <span class="flex shrink-0 -space-x-1">
                        {logos.map((slug) => (
                          <span class="grid size-8 place-items-center rounded-lg border border-line bg-bg-soft">
                            <TechIcon slug={slug} size={20} />
                          </span>
                        ))}
                      </span>
                      <span class="truncate">{name}</span>
                    </span>
                    <span class="flex shrink-0 items-center gap-2 text-muted">
                      <span>{t(pct >= 85 ? "skills.lvl_3" : pct >= 70 ? "skills.lvl_2" : "skills.lvl_1")}</span>
                      <span class="flex gap-0.5" aria-hidden="true">
                        {[1, 2, 3].map((n) => (
                          <span class:list={["h-3 w-1.5 rounded-full", n <= (pct >= 85 ? 3 : pct >= 70 ? 2 : 1) ? "bg-accent-2" : "bg-line"]} />
                        ))}
                      </span>
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <article data-reveal class="ai-card relative mt-5 overflow-hidden rounded-3xl p-px">
      <div class="relative flex flex-col gap-6 rounded-[calc(1.5rem-1px)] bg-bg-soft/95 p-6 sm:p-7 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-sm">
          <p class="mb-2 flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] text-accent-2 uppercase">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent-2 opacity-60"></span>
              <span class="relative inline-flex size-2 rounded-full bg-accent-2"></span>
            </span>
            AI · agents
          </p>
          <h3 class="font-display text-xl font-semibold sm:text-2xl">{t("skills.ai")}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{t("skills.ai_desc")}</p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-3 lg:w-[36rem] lg:shrink-0">
          {
            aiAgents.map(({ slug }) => (
              <li class="glass flex items-center gap-3 rounded-2xl p-3 transition-colors hover:bg-card-hover">
                <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-line bg-bg">
                  <TechIcon slug={slug} size={26} />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold">{tech[slug].name}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>
  </div>
</section>
