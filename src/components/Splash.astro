---
// Splash shown on every load: lines of abstract, syntax-coloured "code" draw themselves in one
// after the other, then the screen folds up onto the site. Pure CSS so it starts on first paint;
// the total length is --splash in global.css.
type Token = [color: "a" | "b" | "c" | "m", width: number];
const lines: { indent: number; tokens: Token[] }[] = [
  { indent: 0, tokens: [["a", 14], ["m", 22], ["b", 10]] },
  { indent: 1, tokens: [["c", 18], ["m", 12], ["b", 26]] },
  { indent: 1, tokens: [["b", 10], ["m", 30]] },
  { indent: 2, tokens: [["a", 12], ["c", 20], ["m", 14]] },
  { indent: 1, tokens: [["m", 8]] },
  { indent: 0, tokens: [["a", 6]] },
];
let n = 0;
---

<div id="splash" class="fixed inset-0 z-[100] place-items-center overflow-hidden bg-bg-soft" aria-hidden="true">
  <div class="sp-glow absolute top-1/2 left-1/2 size-[26rem] rounded-full bg-accent/20 blur-[100px]"></div>
  <div class="bg-grid absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,black_10%,transparent_65%)]"></div>

  <div class="sp-inner relative flex w-[min(17rem,66vw)] flex-col gap-3.5">
    {
      lines.map((line, i) => (
        <div class="flex items-center gap-2" style={`padding-left:${line.indent * 1.25}rem`}>
          {line.tokens.map(([color, w]) => (
            <span class={`sp-tok sp-${color}`} style={`--i:${n++};width:${w / 4}rem`} />
          ))}
          {i === lines.length - 1 && <span class="sp-caret ml-1 inline-block h-4 w-[3px] bg-accent-2" />}
        </div>
      ))
    }
  </div>
</div>

<style>
  #splash {
    display: none;
  }
  :global(.js-motion) #splash {
    display: grid;
    clip-path: inset(0 0 0 0);
    animation: sp-exit 0.6s cubic-bezier(0.76, 0, 0.24, 1) calc(var(--splash) - 0.6s) forwards;
  }

  .sp-inner {
    animation: sp-inner-out 0.4s cubic-bezier(0.55, 0, 1, 0.45) calc(var(--splash) - 0.65s) forwards;
  }
  .sp-glow {
    animation: sp-glow 1.6s ease-in-out infinite alternate;
  }

  .sp-tok {
    display: block;
    height: 0.65rem;
    border-radius: 999px;
    transform-origin: left center;
    animation: sp-draw 0.22s cubic-bezier(0.2, 0.8, 0.3, 1) calc(0.1s + var(--i) * 0.045s) backwards;
  }
  .sp-a {
    background: var(--accent);
  }
  .sp-b {
    background: var(--accent-2);
  }
  .sp-c {
    background: var(--accent-3);
  }
  .sp-m {
    background: var(--muted);
    opacity: 0.45;
  }
  .sp-caret {
    animation:
      sp-fade 0.1s linear 0.75s backwards,
      sp-blink 0.5s steps(1) 0.85s infinite;
  }

  @keyframes sp-draw {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes sp-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes sp-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes sp-glow {
    from {
      opacity: 0.6;
      transform: translate(-50%, -50%) scale(0.85);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }
  @keyframes sp-inner-out {
    to {
      opacity: 0;
      transform: translateY(-20px);
      filter: blur(4px);
    }
  }
  @keyframes sp-exit {
    to {
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
    }
  }
</style>
