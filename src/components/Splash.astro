---
// Splash shown on every load: `<` and `/>` pop in, "dieudonne" types itself
// between them, a build bar compiles, then the screen folds up onto the site.
// Pure CSS so it starts on first paint; the total length is --splash in global.css.
---

<div id="splash" class="fixed inset-0 z-[100] place-items-center overflow-hidden bg-bg-soft" aria-hidden="true">
  <div class="sp-glow absolute top-1/2 left-1/2 size-[28rem] rounded-full bg-accent/25 blur-[100px]"></div>
  <div class="bg-grid absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,black_10%,transparent_65%)]"></div>

  <div class="sp-inner relative flex flex-col items-center gap-7">
    <p class="sp-cmd font-mono text-[11px] tracking-wide text-muted sm:text-xs">
      <span class="text-accent-3">➜</span> <span class="text-accent-2">~/portfolio</span> npm run build
    </p>

    <div class="sp-logo flex items-center font-mono text-[clamp(2.2rem,9vw,4.75rem)] leading-none font-semibold tracking-tight">
      <span class="sp-lt text-accent">&lt;</span>
      <span class="sp-name overflow-hidden whitespace-nowrap text-fg">dieudonne</span>
      <span class="sp-caret ml-[0.05em] inline-block h-[0.85em] w-[0.5ch] bg-accent-2"></span>
      <span class="sp-sl ml-[0.15em] text-accent-2">/</span>
      <span class="sp-gt text-accent">&gt;</span>
    </div>

    <div class="flex w-[min(20rem,70vw)] flex-col gap-3">
      <div class="relative h-[2px] overflow-hidden rounded-full bg-line">
        <span class="sp-fill absolute inset-0 origin-left bg-gradient-to-r from-accent to-accent-2"></span>
      </div>
      <p class="sp-ok text-center font-mono text-[11px] text-accent-3 sm:text-xs">✓ compiled successfully</p>
    </div>
  </div>
</div>

<style>
  #splash {
    display: none;
  }
  :global(.js-motion) #splash {
    display: grid;
    clip-path: inset(0 0 0 0);
    animation: sp-exit 0.6s cubic-bezier(0.76, 0, 0.24, 1) calc(var(--splash) - 0.6s) forwards;
  }

  .sp-cmd {
    animation: sp-fade 0.4s ease-out 0.05s backwards;
  }
  .sp-lt,
  .sp-sl,
  .sp-gt {
    display: inline-block;
    animation: sp-pop 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.2) backwards;
  }
  .sp-sl {
    animation-delay: 0.08s;
  }
  .sp-gt {
    animation-delay: 0.14s;
  }
  /* Typing: the name grows one character at a time, pushing "/>" outward */
  .sp-name {
    width: 9ch;
    animation: sp-type 0.5s steps(9, end) 0.35s backwards;
  }
  .sp-caret {
    animation:
      sp-fade 0.1s linear 0.3s backwards,
      sp-blink 0.5s steps(1) 0.85s infinite;
  }
  .sp-logo {
    animation: sp-glitch 0.24s steps(3) calc(var(--splash) - 0.8s);
  }
  .sp-fill {
    transform: scaleX(1);
    animation: sp-fill 0.55s cubic-bezier(0.65, 0, 0.35, 1) 0.45s backwards;
  }
  .sp-ok {
    animation: sp-fade 0.3s ease-out 0.95s backwards;
  }
  .sp-glow {
    animation: sp-glow 1.6s ease-in-out infinite alternate;
  }
  .sp-inner {
    animation: sp-inner-out 0.4s cubic-bezier(0.55, 0, 1, 0.45) calc(var(--splash) - 0.65s) forwards;
  }

  @keyframes sp-pop {
    from {
      opacity: 0;
      transform: translateY(0.3em) scale(0.4) rotate(-12deg);
      filter: blur(6px);
    }
  }
  @keyframes sp-type {
    from {
      width: 0;
    }
  }
  @keyframes sp-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes sp-fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @keyframes sp-fill {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes sp-glitch {
    0% {
      text-shadow: 3px 0 #ff2d75, -3px 0 #22d3ee;
      transform: translateX(2px) skewX(-6deg);
    }
    50% {
      text-shadow: -4px 0 #ff2d75, 4px 0 #22d3ee;
      transform: translateX(-3px) skewX(5deg);
    }
    100% {
      text-shadow: none;
      transform: none;
    }
  }
  @keyframes sp-glow {
    from {
      opacity: 0.6;
      transform: translate(-50%, -50%) scale(0.85);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }
  @keyframes sp-inner-out {
    to {
      opacity: 0;
      transform: translateY(-28px) scale(0.96);
      filter: blur(4px);
    }
  }
  @keyframes sp-exit {
    to {
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
    }
  }
</style>
