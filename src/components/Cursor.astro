<div id="cursor" class="pointer-events-none fixed top-0 left-0 z-[90] hidden" aria-hidden="true">
  <div data-cursor-ring class="absolute -top-5 -left-5 grid size-10 place-items-center rounded-full border border-white/80 shadow-[0_0_0_1px_rgb(0_0_0/0.35)]">
    <span data-cursor-label class="font-mono text-[9px] tracking-widest text-white uppercase opacity-0"></span>
  </div>
  <div data-cursor-dot class="absolute -top-[3px] -left-[3px] size-1.5 rounded-full bg-white shadow-[0_0_0_1px_rgb(0_0_0/0.35)]"></div>
</div>
