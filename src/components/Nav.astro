---
import Icon from "./Icon.astro";
import { languages, pathFor, useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const links = [
  ["#about", t("nav.about")],
  ["#skill", t("nav.skills")],
  ["#portfolio", t("nav.portfolio")],
  ["#experience", t("nav.experience")],
  ["#formation", t("nav.formation")],
  ["#contact", t("nav.contact")],
] as const;
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-500 data-[scrolled]:border-line data-[scrolled]:bg-bg/85 data-[scrolled]:shadow-[0_8px_30px_-12px_rgb(0_0_0/0.35)] data-[scrolled]:backdrop-blur-xl data-[scrolled]:backdrop-saturate-150"
  data-dark-label={t("theme.enable_dark")}
  data-light-label={t("theme.enable_light")}
>
  <nav class="container-x flex h-16 items-center justify-between gap-4">
    <a href="#top" class="group flex items-center gap-2 font-mono text-sm font-medium">
      <span class="grid size-8 place-items-center rounded-lg bg-accent text-white transition-transform group-hover:rotate-12">
        DE
      </span>
      <span class="hidden sm:inline">
        <span class="text-muted">~/</span>dieudonne<span class="animate-pulse text-accent-2">_</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map(([href, label]) => (
          <li>
            <a
              href={href}
              data-nav-link
              class="rounded-full px-3 py-2 text-[13px] text-muted transition-colors hover:text-fg data-[active]:text-fg"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="glass grid size-9 place-items-center rounded-full transition-transform hover:scale-105"
        aria-label={t("theme.enable_light")}
        title={t("theme.enable_light")}
      >
        <Icon name="sun" size={16} class="theme-icon-sun" />
        <Icon name="moon" size={16} class="theme-icon-moon hidden" />
      </button>

      <div class="relative" id="lang-switcher">
        <button
          type="button"
          class="glass flex h-9 items-center gap-1.5 rounded-full px-3 font-mono text-xs"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={t("nav.language")}
        >
          <Icon name="globe" size={14} />
          {lang.toUpperCase()}
        </button>
        <ul
          class="glass invisible absolute right-0 mt-2 w-40 origin-top-right scale-95 rounded-2xl bg-bg-soft! p-1.5 opacity-0 shadow-2xl transition-all duration-200 data-[open]:visible data-[open]:scale-100 data-[open]:opacity-100"
        >
          {
            (Object.entries(languages) as [Lang, string][]).map(([code, label]) => (
              <li>
                <a
                  href={pathFor(code)}
                  data-lang={code}
                  aria-current={code === lang ? "true" : undefined}
                  class="flex items-center justify-between rounded-xl px-3 py-2 text-sm hover:bg-card-hover aria-[current]:text-accent"
                >
                  {label}
                  <span class="font-mono text-xs text-muted">{code.toUpperCase()}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="glass grid size-9 place-items-center rounded-full lg:hidden"
        aria-label={t("nav.menu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={16} />
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="invisible fixed inset-0 top-16 z-40 bg-bg/95 opacity-0 backdrop-blur-xl transition-all duration-300 data-[open]:visible data-[open]:opacity-100 lg:hidden"
  >
    <ul class="container-x flex flex-col gap-1 pt-8">
      {
        links.map(([href, label], i) => (
          <li>
            <a href={href} class="flex items-baseline gap-4 border-b border-line py-4 font-display text-2xl">
              <span class="font-mono text-xs text-accent-2">0{i + 1}</span>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
