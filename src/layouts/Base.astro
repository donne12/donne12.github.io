---
import "../styles/global.css";
import { defaultLang, languages, pathFor, useTranslations, type Lang } from "../i18n/utils";
// Self-hosted fonts (bundled via global.css); preload the ones used above the fold.
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import displayFont from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import monoFont from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site?.origin ?? "https://esiakudonne.me";
const canonical = new URL(pathFor(lang), site).href;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dieudonné | Portfolio</title>
    <meta name="description" content={t("meta.description")} />
    <link rel="canonical" href={canonical} />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(pathFor(l), site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor(defaultLang), site).href} />
    <meta property="og:title" content="Dieudonné ESIAKU | Portfolio" />
    <meta property="og:description" content={t("meta.description")} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/images/og.png", site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dieudonné ESIAKU, Fullstack Developer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/images/og.png", site).href} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#06070b" />
    <link rel="icon" type="image/png" href="/images/unnamed.png" />
    <link rel="apple-touch-icon" href="/images/unnamed.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <script is:inline define:vars={{ lang, defaultLang, supported: Object.keys(languages) }}>
      (function () {
        var root = document.documentElement;

        // Every load starts on the hero: drop any #section and don't restore the old scroll.
        try {
          if ("scrollRestoration" in history) history.scrollRestoration = "manual";
          if (location.hash) history.replaceState(null, "", location.pathname + location.search);
        } catch (e) {}
        try {
          var saved = localStorage.getItem("site-theme");
          var theme =
            saved === "light" || saved === "dark"
              ? saved
              : matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          root.setAttribute("data-theme", theme);
        } catch (e) {}

        // Same behaviour as the old site: honour a saved language, otherwise the browser's.
        if (lang === defaultLang) {
          try {
            var pref = localStorage.getItem("site-lang");
            if (!pref) pref = (navigator.language || "").slice(0, 2).toLowerCase();
            if (pref !== defaultLang && supported.indexOf(pref) !== -1) {
              location.replace("/" + pref + "/");
            }
          } catch (e) {}
        }

        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.classList.add("js-motion");
          // The splash (pure CSS, see Splash.astro) only plays on the first visit of a session.
          try {
            if (!sessionStorage.getItem("splash-seen")) {
              sessionStorage.setItem("splash-seen", "1");
              root.classList.add("js-splash");
            }
          } catch (e) {
            root.classList.add("js-splash");
          }
          // Never leave content hidden if the animation bundle fails to load.
          setTimeout(function () {
            if (!window.__motionReady) root.classList.remove("js-motion");
          }, 4000);
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh overflow-x-hidden">
    <slot />
  </body>
</html>
